#!/usr/bin/env bash
# hz — Hetzner Cloud dev-server manager: servers + ~/.ssh/config Host entries
#
# Usage:
#   hz list                                    Servers: name, status, ipv4, type, idle
#   hz small|medium|max <name>                 Size presets — create + ssh-add with
#                                              2h idle-shutdown, ready to `ssh <name>`:
#       small    cx23    2 vCPU shared    /   4 GB /  40 GB   EUR 0.0104/h  (~6.49/mo)
#       medium   cx43    8 vCPU shared    /  16 GB / 160 GB   EUR 0.0296/h  (~18.49/mo)
#       max      ccx63  48 vCPU dedicated / 192 GB / 960 GB   EUR 1.6138/h  (~1007/mo)
#     small/medium imply --yes; max needs an explicit --yes (155x small's rate).
#     Any create option overrides the preset: hz medium box --idle-hours 4
#   hz up <name> [create options]              Like the presets but with the bare
#                                              `create` default type; implies --yes
#   hz create <name> --yes [options]           Create server (cloud-init via
#                                              hetzner-user-data.sh) + ssh-add,
#                                              then block until bootstrap ends
#       --type cx23            server type (hcloud server-type list)
#       --location hel1        location (hel1/fsn1/nbg1 EU, ash/hil US, sin APAC)
#       --image ubuntu-24.04   OS image
#       --ssh-key <name>       hcloud SSH key (auto-picked when exactly one exists)
#       --user k-kit           user for the ssh config entry
#       --branch main          dotfiles branch the box bootstraps from
#       --idle-shutdown        OPT-IN auto-poweroff when idle (default OFF)
#       --idle-hours N         idle threshold in hours, implies --idle-shutdown (default 2)
#       --github-auth          OPT-IN: push `fnox get GITHUB_TOKEN` over SSH
#                              after boot and run `gh auth login --with-token`
#       --no-wait              return as soon as the server exists
#       --timeout N            seconds to wait for bootstrap (default 900)
#   hz wait <server> [--timeout N]             Block until cloud-init + the
#                                              dotfiles bootstrap finish; report
#                                              the verdict (and the log on error)
#   hz delete <server> --yes                   Delete server + its ssh config entries
#   hz ssh-add <server> [--user k-kit|root] [--alias <Host>]
#                                              Upsert Host block in ~/.ssh/config
#   hz ssh-sync [--dry-run]                    Host entry per running server
#   hz ssh-rm <alias>                          Remove one hz-managed Host block
#   hz idle enable <server> [--hours N]        Install on-box idle watchdog + set label
#   hz idle disable <server>                   Remove watchdog + label
#   hz idle status <server>                    Label + on-box watchdog state
#   hz poweron <server>                        Wake a powered-off server
#
# Auth: HCLOUD_TOKEN from the environment, else resolved via `fnox get HERTZNER`.
# The token is exported to hcloud only — never printed.
#
# Idle shutdown is DEFAULT OFF. When enabled, the box runs `systemctl poweroff`
# after N hours with no activity — SSH, non-shell tmux panes, or a tty that
# wrote recently (watchdog: scripts/cloud/idle-shutdown-install.sh). Inhibit
# from on the box: `touch ~/.keep-alive`. A powered-off server keeps its disk
# + IP (those still bill): `hz poweron <name>`.
#
# ~/.ssh/config edits are confined to '# BEGIN hz <alias>' ... '# END hz <alias>'
# blocks; the pre-hz config is backed up once to ~/.ssh/config.hz-backup.
#
# GITHUB_TOKEN is never put in user-data: Hetzner's metadata service hands
# user-data to every local user, so a PAT there is readable by anything running
# on the box. `--github-auth` pushes it over SSH after boot instead, and stays
# opt-in because it moves a credential onto a remote machine.
#
# Env overrides: HZ_SSH_CONFIG (default ~/.ssh/config), HZ_SSH_USER (default k-kit),
# HZ_LOCATION (default hel1)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
DOT_DIR="${SCRIPT_DIR%/custom_bins}"
USER_DATA_SCRIPT="$DOT_DIR/scripts/cloud/hetzner-user-data.sh"
IDLE_INSTALLER="$DOT_DIR/scripts/cloud/idle-shutdown-install.sh"

IDLE_LABEL="dotfiles.idle-shutdown"
SSH_CONFIG="${HZ_SSH_CONFIG:-$HOME/.ssh/config}"
SSH_BACKUP="${SSH_CONFIG}.hz-backup"
DEFAULT_USER="${HZ_SSH_USER:-k-kit}"
DEFAULT_LOCATION="${HZ_LOCATION:-hel1}"

# Size presets: type + one-line spec. Prices are EUR at hel1, checked against
# `hcloud server-type list` on 2026-08-08 — they drift, so treat them as a
# rough guide and re-check with `hcloud server-type describe <type>`.
# x86 shared for small/medium (matches the existing fleet); ARM (cax*) is
# cheaper per core but the dotfiles bootstrap is only exercised on x86.
preset_type() {
    case "$1" in
        small)  echo "cx23" ;;
        medium) echo "cx43" ;;
        max)    echo "ccx63" ;;
    esac
}

preset_spec() {
    case "$1" in
        small)  echo "2 vCPU shared / 4 GB / 40 GB — EUR 0.0104/h (~6.49/mo)" ;;
        medium) echo "8 vCPU shared / 16 GB / 160 GB — EUR 0.0296/h (~18.49/mo)" ;;
        max)    echo "48 vCPU dedicated / 192 GB / 960 GB — EUR 1.6138/h (~1007/mo)" ;;
    esac
}

usage() {
    awk 'NR==1{next} !/^#/{exit} {sub(/^# ?/,""); print}' "$0"
    exit "${1:-0}"
}

die() { echo "hz: $*" >&2; exit 1; }

require_deps() {
    command -v hcloud >/dev/null 2>&1 || die "hcloud CLI not found (brew install hcloud)"
    command -v jq >/dev/null 2>&1 || die "jq not found"
}

ensure_token() {
    [[ -n "${HCLOUD_TOKEN:-}" ]] && return 0
    command -v fnox >/dev/null 2>&1 \
        || die "HCLOUD_TOKEN is unset and fnox is not installed — export HCLOUD_TOKEN or install fnox"
    HCLOUD_TOKEN="$(FNOX_NON_INTERACTIVE=true fnox get HERTZNER 2>/dev/null || true)"
    [[ -n "$HCLOUD_TOKEN" ]] \
        || die "could not resolve token: HCLOUD_TOKEN unset and 'fnox get HERTZNER' returned nothing"
    export HCLOUD_TOKEN
}

server_ip() {
    local ip
    ip="$(hcloud server describe "$1" -o json 2>/dev/null | jq -r '.public_net.ipv4.ip // empty')"
    [[ -n "$ip" ]] || die "server '$1' not found or has no public IPv4"
    printf '%s' "$ip"
}

# ── ssh config management ──────────────────────────────────────────────────
# Managed blocks are delimited by exact-match marker lines so user content is
# never touched:  # BEGIN hz <alias> ... # END hz <alias>
# A '# hz server: <name>' line inside the block maps alias -> hcloud server.

render_block() { # alias ip user server-name
    printf '# BEGIN hz %s\n# hz server: %s\nHost %s\n    HostName %s\n    User %s\n    StrictHostKeyChecking accept-new\n    ServerAliveInterval 60\n# END hz %s\n' \
        "$1" "$4" "$1" "$2" "$3" "$1"
}

current_block() { # alias
    [[ -f "$SSH_CONFIG" ]] || return 0
    awk -v a="$1" '$0=="# BEGIN hz "a{f=1} f{print} $0=="# END hz "a{f=0}' "$SSH_CONFIG"
}

managed_aliases() {
    [[ -f "$SSH_CONFIG" ]] || return 0
    awk '/^# BEGIN hz /{sub(/^# BEGIN hz /,""); print}' "$SSH_CONFIG"
}

aliases_for_server() { # server-name -> aliases of blocks pointing at it
    [[ -f "$SSH_CONFIG" ]] || return 0
    awk -v s="$1" '
        /^# BEGIN hz /{alias=$0; sub(/^# BEGIN hz /,"",alias)}
        $0=="# hz server: "s && alias!=""{print alias; alias=""}' "$SSH_CONFIG"
}

backup_once() {
    [[ -f "$SSH_BACKUP" ]] && return 0
    if [[ -s "$SSH_CONFIG" ]]; then
        cp -p "$SSH_CONFIG" "$SSH_BACKUP"
        echo "hz: one-time backup: $SSH_CONFIG -> $SSH_BACKUP" >&2
    fi
    return 0
}

write_config() { # stdin -> $SSH_CONFIG, with dir/perm hygiene
    local dir tmp
    dir="$(dirname "$SSH_CONFIG")"
    mkdir -p "$dir"
    tmp="$(mktemp "$dir/.hz-config.XXXXXX")"
    cat > "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$SSH_CONFIG"
}

ssh_upsert() { # alias ip user server-name -> prints added|updated|unchanged
    local alias="$1" ip="$2" user="$3" server="$4" new cur rest
    new="$(render_block "$alias" "$ip" "$user" "$server")"
    cur="$(current_block "$alias")"
    if [[ "$cur" == "$new" ]]; then
        echo "unchanged"
        return 0
    fi
    backup_once
    rest=""
    if [[ -f "$SSH_CONFIG" ]]; then
        # command substitution strips trailing newlines -> exactly one blank
        # line before the appended block, no accumulation across updates
        rest="$(awk -v a="$alias" \
            '$0=="# BEGIN hz "a{f=1; next} $0=="# END hz "a{f=0; next} !f' "$SSH_CONFIG")"
    fi
    {
        [[ -n "$rest" ]] && printf '%s\n\n' "$rest"
        printf '%s\n' "$new"
    } | write_config
    if [[ -n "$cur" ]]; then echo "updated"; else echo "added"; fi
}

ssh_remove_block() { # alias -> prints removed|absent
    local alias="$1" rest
    if [[ -z "$(current_block "$alias")" ]]; then
        echo "absent"
        return 0
    fi
    backup_once
    rest="$(awk -v a="$alias" \
        '$0=="# BEGIN hz "a{f=1; next} $0=="# END hz "a{f=0; next} !f' "$SSH_CONFIG")"
    if [[ -n "$rest" ]]; then
        printf '%s\n' "$rest" | write_config
    else
        : | write_config
    fi
    echo "removed"
}

# ── commands ───────────────────────────────────────────────────────────────

cmd_list() {
    [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && usage
    require_deps
    ensure_token
    hcloud server list -o json | jq -r '
        (["NAME","STATUS","IPV4","TYPE","IDLE"] | @tsv),
        (.[] | [.name, .status, (.public_net.ipv4.ip // "-"), .server_type.name,
                (.labels["'"$IDLE_LABEL"'"] // "off")] | @tsv)' \
        | column -t -s "$(printf '\t')"
}

cmd_ssh_add() {
    local server="" user="$DEFAULT_USER" alias="" ip status
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user) user="${2:?--user needs a value}"; shift 2 ;;
            --alias) alias="${2:?--alias needs a value}"; shift 2 ;;
            -h|--help) usage ;;
            -*) die "ssh-add: unknown option $1" ;;
            *) [[ -n "$server" ]] && die "ssh-add: one server only"; server="$1"; shift ;;
        esac
    done
    [[ -n "$server" ]] || die "usage: hz ssh-add <server> [--user <u>] [--alias <Host>]"
    [[ -n "$alias" ]] || alias="$server"
    require_deps
    ensure_token
    ip="$(server_ip "$server")"
    status="$(ssh_upsert "$alias" "$ip" "$user" "$server")"
    echo "hz: Host '$alias' -> $user@$ip ($status)"
}

cmd_ssh_sync() {
    local dry=0 name ip status verb known
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry=1; shift ;;
            -h|--help) usage ;;
            *) die "ssh-sync: unknown option $1" ;;
        esac
    done
    require_deps
    ensure_token
    local servers_json
    servers_json="$(hcloud server list -o json)"
    while IFS=$'\t' read -r name ip; do
        [[ -n "$name" ]] || continue
        if [[ "$dry" == "1" ]]; then
            local new cur
            new="$(render_block "$name" "$ip" "$DEFAULT_USER" "$name")"
            cur="$(current_block "$name")"
            if [[ "$cur" == "$new" ]]; then verb="unchanged"
            elif [[ -n "$cur" ]]; then verb="would update"
            else verb="would add"; fi
            echo "hz: Host '$name' -> $DEFAULT_USER@$ip ($verb)"
        else
            status="$(ssh_upsert "$name" "$ip" "$DEFAULT_USER" "$name")"
            echo "hz: Host '$name' -> $DEFAULT_USER@$ip ($status)"
        fi
    done < <(jq -r '.[] | select(.status=="running")
                    | [.name, .public_net.ipv4.ip // empty] | @tsv' <<<"$servers_json")
    # flag managed blocks whose server no longer exists (never auto-removed)
    known="$(jq -r '.[].name' <<<"$servers_json")"
    local a s
    while IFS= read -r a; do
        [[ -n "$a" ]] || continue
        s="$(awk -v a="$a" '$0=="# BEGIN hz "a{f=1; next} f && /^# hz server: /{sub(/^# hz server: /,""); print; exit}' "$SSH_CONFIG")"
        if [[ -n "$s" ]] && ! grep -qx -- "$s" <<<"$known"; then
            echo "hz: stale entry 'Host $a' (server '$s' gone) — remove with: hz ssh-rm $a"
        fi
    done < <(managed_aliases)
}

cmd_ssh_rm() {
    local alias="${1:-}"
    [[ "$alias" == "-h" || "$alias" == "--help" ]] && usage
    [[ -n "$alias" ]] || die "usage: hz ssh-rm <alias>"
    local status
    status="$(ssh_remove_block "$alias")"
    echo "hz: Host '$alias' ($status)"
}

# ── post-boot polling ──────────────────────────────────────────────────────
# sshd refuses connections for the first ~20-30s of a fresh boot, so every
# remote step here is a bounded retry loop rather than a single attempt, and
# every one of them times out with an actionable message instead of hanging.

ssh_root() { # ip cmd...  — non-interactive, short connect timeout
    local ip="$1"; shift
    ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
        -o ConnectTimeout=10 -o LogLevel=ERROR "root@$ip" "$@"
}

cmd_wait() {
    local name="" timeout=900
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --timeout) timeout="${2:?--timeout needs a value}"; shift 2 ;;
            -h|--help) usage ;;
            -*) die "wait: unknown option $1" ;;
            *) [[ -n "$name" ]] && die "wait: one server only"; name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: hz wait <server> [--timeout N]"
    [[ "$timeout" =~ ^[0-9]+$ && "$timeout" -ge 1 ]] || die "wait: --timeout must be a positive integer"
    require_deps
    ensure_token
    local ip
    ip="$(server_ip "$name")"
    wait_for_bootstrap "$name" "$ip" "$timeout"
}

wait_for_bootstrap() { # name ip timeout-seconds
    local name="$1" ip="$2" timeout="$3" deadline remaining verdict ci_rc
    deadline=$(( $(date +%s) + timeout ))

    echo "hz: waiting for '$name' ($ip) — sshd, then cloud-init (timeout ${timeout}s)"
    until ssh_root "$ip" true >/dev/null 2>&1; do
        if [[ "$(date +%s)" -ge "$deadline" ]]; then
            echo "hz: sshd on $ip still unreachable after ${timeout}s — retry: hz wait $name" >&2
            return 1
        fi
        sleep 5
    done

    # cloud-init's own --wait can outlast our budget, so cap it server-side.
    # Exit 0/1/2 all mean "finished" (done / error / degraded) — a failed
    # bootstrap is still a finish, and we must read the status file rather than
    # treating it like a budget miss. Only timeout(1)'s 124 is "still going".
    remaining=$(( deadline - $(date +%s) ))
    [[ "$remaining" -lt 1 ]] && remaining=1
    ci_rc=0
    ssh_root "$ip" "timeout $remaining cloud-init status --wait" >/dev/null 2>&1 || ci_rc=$?
    case "$ci_rc" in
        0|1|2) ;;
        124)
            echo "hz: cloud-init has not finished within the budget — retry: hz wait $name" >&2
            return 1 ;;
        *)
            echo "hz: could not wait on cloud-init (exit $ci_rc) — retry: hz wait $name" >&2
            return 1 ;;
    esac

    verdict="$(ssh_root "$ip" 'cat /var/lib/dotfiles-bootstrap.status 2>/dev/null' 2>/dev/null || true)"
    case "$verdict" in
        ok)
            echo "hz: '$name' is ready — ssh $name"
            return 0 ;;
        ""|unknown)
            echo "hz: cloud-init finished but the dotfiles bootstrap left no verdict." >&2
            echo "hz: check: ssh root@$ip tail -50 /var/log/dotfiles-bootstrap.log" >&2
            return 1 ;;
        *)
            echo "hz: dotfiles bootstrap reported '$verdict' — last 30 log lines:" >&2
            ssh_root "$ip" 'tail -30 /var/log/dotfiles-bootstrap.log' >&2 2>/dev/null || true
            return 1 ;;
    esac
}

push_github_token() { # ip user — OPT-IN; moves a PAT onto the remote box
    local ip="$1" user="$2" tok
    command -v fnox >/dev/null 2>&1 || {
        echo "hz: --github-auth needs fnox — skipping (run 'gh auth login' on the box)" >&2
        return 1
    }
    tok="$(FNOX_NON_INTERACTIVE=true fnox get GITHUB_TOKEN 2>/dev/null || true)"
    [[ -n "$tok" ]] || {
        echo "hz: 'fnox get GITHUB_TOKEN' returned nothing — skipping gh auth" >&2
        return 1
    }
    # stdin, never argv or user-data: argv is world-readable via /proc and
    # user-data is served to every local user by the metadata service
    if printf '%s\n' "$tok" | ssh_root "$ip" \
        "sudo -u '$user' -i gh auth login --with-token && sudo -u '$user' -i gh auth setup-git" \
        >/dev/null 2>&1
    then
        echo "hz: gh authenticated for '$user' (token from fnox, pushed over SSH)"
    else
        echo "hz: gh auth login --with-token failed — run 'gh auth login' on the box" >&2
        return 1
    fi
}

cmd_create() {
    local name="" type="cpx42" image="ubuntu-24.04" sshkey="" user="$DEFAULT_USER"
    local location="$DEFAULT_LOCATION" idle=0 hours=2 yes=0
    local branch="main" wait=1 timeout=900 ghauth=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --type) type="${2:?}"; shift 2 ;;
            --location) location="${2:?}"; shift 2 ;;
            --image) image="${2:?}"; shift 2 ;;
            --ssh-key) sshkey="${2:?}"; shift 2 ;;
            --user) user="${2:?}"; shift 2 ;;
            --branch) branch="${2:?}"; shift 2 ;;
            --idle-shutdown) idle=1; shift ;;
            --idle-hours) hours="${2:?}"; idle=1; shift 2 ;;
            --github-auth) ghauth=1; shift ;;
            --no-wait) wait=0; shift ;;
            --timeout) timeout="${2:?}"; shift 2 ;;
            --yes) yes=1; shift ;;
            -h|--help) usage ;;
            -*) die "create: unknown option $1" ;;
            *) [[ -n "$name" ]] && die "create: one server name only"; name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: hz create <name> --yes [--type t] [--location l] [--image i] [--ssh-key k] [--branch b] [--idle-shutdown] [--idle-hours N] [--github-auth] [--no-wait] [--timeout N]"
    [[ "$hours" =~ ^[0-9]+$ && "$hours" -ge 1 ]] || die "create: --idle-hours must be a positive integer"
    [[ "$timeout" =~ ^[0-9]+$ && "$timeout" -ge 1 ]] || die "create: --timeout must be a positive integer"
    [[ -x "$USER_DATA_SCRIPT" ]] || die "missing $USER_DATA_SCRIPT"
    [[ -f "$IDLE_INSTALLER" ]] || die "missing $IDLE_INSTALLER"

    # The --yes gate comes before require_deps/ensure_token on purpose: previewing
    # what would be created should not need the hcloud CLI, a Hetzner token, or an
    # API round-trip. ssh-key is the one field not yet resolved at this point.
    if [[ "$yes" != "1" ]]; then
        echo "hz: would create (paid!): name=$name type=$type location=$location image=$image ssh-key=${sshkey:-<auto>} branch=$branch idle-shutdown=$([[ $idle == 1 ]] && echo "${hours}h" || echo off) wait=$([[ $wait == 1 ]] && echo "${timeout}s" || echo off) github-auth=$([[ $ghauth == 1 ]] && echo on || echo off)"
        die "refusing to create a paid server without --yes"
    fi

    require_deps
    ensure_token

    if [[ -z "$sshkey" ]]; then
        local keys nkeys
        keys="$(hcloud ssh-key list -o json | jq -r '.[].name')"
        nkeys="$(grep -c . <<<"$keys" || true)"
        if [[ "$nkeys" == "1" ]]; then
            sshkey="$keys"
        else
            die "create: pass --ssh-key <name>; available keys:"$'\n'"$keys"
        fi
    fi

    local ud
    ud="$(mktemp "${TMPDIR:-/tmp}/hz-user-data.XXXXXX")"
    trap 'rm -f "$ud"' EXIT
    "$USER_DATA_SCRIPT" --branch "$branch" > "$ud"

    local -a label_args=()
    if [[ "$idle" == "1" ]]; then
        # ship the watchdog inside cloud-init: append one runcmd step (runs
        # after dotfiles-bootstrap; base64 keeps the YAML single-line-safe)
        local b64
        b64="$(base64 < "$IDLE_INSTALLER" | tr -d '\n')"
        printf '  - [ bash, -c, "printf %%s %s | base64 -d > /usr/local/sbin/idle-shutdown-install && bash /usr/local/sbin/idle-shutdown-install install %s" ]\n' \
            "$b64" "$hours" >> "$ud"
        label_args=(--label "$IDLE_LABEL=${hours}h")
    fi

    echo "hz: creating $name ($type, $location, $image, key=$sshkey)..."
    hcloud server create --name "$name" --type "$type" --location "$location" \
        --image "$image" --ssh-key "$sshkey" --user-data-from-file "$ud" \
        ${label_args[@]+"${label_args[@]}"}
    rm -f "$ud"
    trap - EXIT

    local ip status
    ip="$(server_ip "$name")"
    status="$(ssh_upsert "$name" "$ip" "$user" "$name")"
    echo "hz: Host '$name' -> $user@$ip ($status)"

    if [[ "$wait" != "1" ]]; then
        echo
        echo "Next steps:"
        echo "  hz wait $name                           # blocks until bootstrap finishes"
        echo "  ssh $name                               # dotfiles user once it is done"
        [[ "$idle" == "1" ]] && {
            echo "  hz idle status $name                    # watchdog state (installed by cloud-init)"
            echo "  # box powers off after ${hours}h idle — wake: hz poweron $name; inhibit: touch ~/.keep-alive"
        }
        return 0
    fi

    echo
    local rc=0
    wait_for_bootstrap "$name" "$ip" "$timeout" || rc=$?
    if [[ "$rc" == "0" && "$ghauth" == "1" ]]; then
        push_github_token "$ip" "$user" || true
    fi
    if [[ "$rc" == "0" ]]; then
        if [[ "$ghauth" == "1" ]]; then
            echo "  remaining: claude  (OAuth login — cannot be automated)"
        else
            echo "  remaining: gh auth login  (or re-run with --github-auth); claude  (OAuth)"
        fi
        [[ "$idle" == "1" ]] && \
            echo "  idle: powers off after ${hours}h — wake: hz poweron $name; inhibit: touch ~/.keep-alive"
    fi
    return "$rc"
}

cmd_preset() { # preset-name <server-name> [create options...]
    local preset="$1"; shift
    local type spec
    type="$(preset_type "$preset")"
    spec="$(preset_spec "$preset")"
    [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && usage
    [[ -n "${1:-}" ]] || die "usage: hz $preset <name>   ($type — $spec)"

    # `max` costs ~155x `small` per hour — no implied --yes for that one.
    local -a gate=(--yes)
    if [[ "$preset" == "max" ]]; then
        gate=()
        printf 'hz: %s = %s — %s\n' "$preset" "$type" "$spec" >&2
    fi
    echo "hz: preset $preset -> $type ($spec)" >&2
    # preset flags first so a user-supplied --type/--idle-hours still wins
    cmd_create --type "$type" --idle-shutdown ${gate[@]+"${gate[@]}"} "$@"
}

cmd_delete() {
    local name="" yes=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes) yes=1; shift ;;
            -h|--help) usage ;;
            -*) die "delete: unknown option $1" ;;
            *) [[ -n "$name" ]] && die "delete: one server only"; name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: hz delete <server> --yes"
    require_deps
    ensure_token
    [[ "$yes" == "1" ]] || die "refusing to delete server '$name' without --yes (irreversible)"
    hcloud server delete "$name"
    echo "hz: server '$name' deleted"
    local a
    while IFS= read -r a; do
        [[ -n "$a" ]] || continue
        echo "hz: Host '$a' ($(ssh_remove_block "$a"))"
    done < <(aliases_for_server "$name")
}

idle_ssh() { # ip installer-args...
    local ip="$1"; shift
    ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
        "root@$ip" "bash -s -- $*" < "$IDLE_INSTALLER"
}

cmd_idle() {
    local sub="${1:-}"; shift || true
    local server="" hours=2
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --hours) hours="${2:?}"; shift 2 ;;
            -h|--help) usage ;;
            -*) die "idle: unknown option $1" ;;
            *) [[ -n "$server" ]] && die "idle: one server only"; server="$1"; shift ;;
        esac
    done
    case "$sub" in enable|disable|status) ;; -h|--help|"") usage ;; *) die "idle: unknown subcommand '$sub' (enable|disable|status)" ;; esac
    [[ -n "$server" ]] || die "usage: hz idle $sub <server>"
    [[ "$hours" =~ ^[0-9]+$ && "$hours" -ge 1 ]] || die "idle: --hours must be a positive integer"
    [[ -f "$IDLE_INSTALLER" ]] || die "missing $IDLE_INSTALLER"
    require_deps
    ensure_token
    local ip
    ip="$(server_ip "$server")"
    case "$sub" in
        enable)
            hcloud server add-label --overwrite "$server" "$IDLE_LABEL=${hours}h" >/dev/null
            idle_ssh "$ip" install "$hours"
            echo "hz: label $IDLE_LABEL=${hours}h set on '$server'"
            ;;
        disable)
            hcloud server remove-label "$server" "$IDLE_LABEL" >/dev/null 2>&1 || true
            idle_ssh "$ip" uninstall
            echo "hz: label $IDLE_LABEL removed from '$server'"
            ;;
        status)
            local label
            label="$(hcloud server describe "$server" -o json | jq -r '.labels["'"$IDLE_LABEL"'"] // "off"')"
            echo "label: $IDLE_LABEL=$label"
            idle_ssh "$ip" status \
                || echo "hz: box unreachable over SSH (root@$ip) — label shown above is all we know"
            ;;
    esac
}

cmd_poweron() {
    local name="${1:-}"
    [[ "$name" == "-h" || "$name" == "--help" ]] && usage
    [[ -n "$name" ]] || die "usage: hz poweron <server>"
    require_deps
    ensure_token
    hcloud server poweron "$name"
}

p=""
case "${1:-}" in
    list) shift; cmd_list "$@" ;;
    create) shift; cmd_create "$@" ;;
    wait) shift; cmd_wait "$@" ;;
    up) shift; cmd_create --idle-shutdown --yes "$@" ;;
    small|medium|max) p="$1"; shift; cmd_preset "$p" "$@" ;;
    delete) shift; cmd_delete "$@" ;;
    ssh-add) shift; cmd_ssh_add "$@" ;;
    ssh-sync) shift; cmd_ssh_sync "$@" ;;
    ssh-rm) shift; cmd_ssh_rm "$@" ;;
    idle) shift; cmd_idle "$@" ;;
    poweron) shift; cmd_poweron "$@" ;;
    # hidden helpers for shell completion (config/completions.sh)
    _servers) require_deps; ensure_token; hcloud server list -o json | jq -r '.[].name' ;;
    _aliases) managed_aliases ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command '${1}' (see hz --help)" ;;
esac
